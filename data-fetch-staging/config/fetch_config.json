      {
        "asset_id": "10012", "name": "Blender", "enabled": true,
        "datasets": [
          {"name": "blend_recipe", "point": "db:HMI.Blend_Recipe<@BatchNo='{batch_no}', @LotNo='{lot_no}', @AssetId='{asset_id}'>"},
