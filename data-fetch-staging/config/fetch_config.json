  },
  "file_fetch": {
    "enabled": true,
    "continuous_fetch": false,
    "schedule_minutes": 20,
    "network_path": "CONFIGURE_COMPRESSION_NETWORK_PATH",
    "folder_grouping": "AUTO",
    "daily_folder_format": "%Y-%m-%d",
    "local_staging_folder": "./staging/files_raw",
    "metadata_folder": "./staging/metadata",
    "retry_count": 3,
    "retry_delay_seconds": 5,
    "max_files_per_cycle": 100,
    "deduplicate": true
  }
