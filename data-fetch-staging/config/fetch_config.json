          {"name": "fbd_recipe", "point": "db:HMI.FBD_Recipe<@AssetId='{asset_id}', @BatchNo='{batch_no}', @LotNo='{lot_no}'>"},
          {"name": "fbd_min_max", "point": "db:HMI.FBD_Min_Max<@AssetId='{asset_id}', @BatchNo='{batch_no}', @LotNo='{lot_no}'>"}
        ]
      },
      {
        "asset_id": "10021", "name": "Coating", "enabled": true,
        "datasets": [
          {"name": "coat_operational_data", "point": "db:HMI.Coat_Op_Data<@BatchNo='{batch_no}', @LotNo='{lot_no}', @AssetId='{asset_id}'>"},
          {"name": "coat_recipe", "point": "db:HMI.Coat_Recipe<@BatchNo='{batch_no}', @LotNo='{lot_no}', @AssetId='{asset_id}'>"},
          {"name": "coat_min_max", "point": "db:HMI.Coat_Min_Max<@BatchNo='{batch_no}', @LotNo='{lot_no}', @AssetId='{asset_id}'>"}
        ]
