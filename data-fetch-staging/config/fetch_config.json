      {"name": "alarms", "point": "db:HMI.Alarms<@AssetId={asset_id}, @BatchNo='{batch_no}', @LotNo='{lot_no}'>"},
      {"name": "audit_trail", "point": "db:HMI.Audit_Trail<@AssetId={asset_id}, @BatchNo='{batch_no}', @LotNo='{lot_no}'>"}
