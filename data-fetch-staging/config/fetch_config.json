      "grant_type": "CONFIGURE_PASSWORD_OR_CLIENT_CREDENTIALS",
      "token_url": "CONFIGURE_OAUTH_TOKEN_URL",
      "client_auth_method": "basic",
      "username_env": "ADAVIS_OAUTH_USERNAME",
      "password_env": "ADAVIS_OAUTH_PASSWORD",
      "client_id_env": "ADAVIS_OAUTH_CLIENT_ID",
      "client_secret_env": "ADAVIS_OAUTH_CLIENT_SECRET"
    },
    "batch_list_point": "db:HMI.Batch_Info<@AssetId={asset_id}, @Batch_No=''>",
