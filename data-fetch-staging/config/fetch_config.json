{
  "api_fetch": {
    "enabled": true,
    "continuous_fetch": false,
    "schedule_minutes": 20,
    "base_url": "https://u3-miebmr-srv-t",
    "dataset_path": "/fwxapi/rest/v1/Dataset",
    "request_timeout_seconds": 60,
    "max_batches_per_asset_per_cycle": 3,
    "raw_response_folder": "./staging/api_raw",
