# Compression File Ingestion Service Environment Configuration
MONGO_URI=mongodb://admin:Admin123!@localhost:37017/adavis_platform?authSource=admin
MONGO_DB_NAME=adavis_platform

# Remote Source Path (e.g. \\192.168.1.100\Sejong_Data\Sawc or local folder)
REMOTE_SOURCE_PATH=
LOCAL_SOURCE_PATH=../compression_server

# Ingestion Control
INGESTION_MODE=APPEND
AUTO_DISCOVER_DATES=true
START_DATE=2026-09-01
END_DATE=2026-09-30
SCHEDULE_MINUTES=15
CONTINUOUS_RUN=false
EXPORT_PDF=true
EXPORT_JSON=true
