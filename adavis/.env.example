# Frontend runtime/API routing configuration
# For EC2 where backend API gateway runs on the same host and port 80,
# localhost is a safe default.
API_GATEWAY_URL=http://127.0.0.1

# Optional per-service overrides (if omitted, API_GATEWAY_URL is used)
AUTH_SERVICE_URL=http://127.0.0.1
MDM_SERVICE_URL=http://127.0.0.1
IIOT_SERVICE_URL=http://127.0.0.1
LICENSE_SERVICE_URL=http://127.0.0.1
AUDIT_SERVICE_URL=http://127.0.0.1

# Browser-side base URL used by frontend API client
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1
