# ------------------------------------------------------------
# Frontend environment template
# Copy this file to .env.production and pick ONE section.
# ------------------------------------------------------------

# Local development (backend services on localhost ports)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:9080
# AUTH_SERVICE_URL=http://localhost:9081
# MDM_SERVICE_URL=http://localhost:9083
# IIOT_SERVICE_URL=http://localhost:9085
# LICENSE_SERVICE_URL=http://localhost:8082
# AUDIT_SERVICE_URL=http://localhost:8084

# ------------------------------------------------------------
# EC2 deployment (backend gateway on same host via port 80)
# Uncomment this section on EC2 and comment out local values.
# API_GATEWAY_URL should stay host-local for server-side routes.
# ------------------------------------------------------------
API_GATEWAY_URL=http://127.0.0.1
NEXT_PUBLIC_API_BASE_URL=http://3.24.80.154
AUTH_COOKIE_SECURE=false
AUTH_SERVICE_URL=http://127.0.0.1
MDM_SERVICE_URL=http://127.0.0.1
IIOT_SERVICE_URL=http://127.0.0.1
LICENSE_SERVICE_URL=http://127.0.0.1
AUDIT_SERVICE_URL=http://127.0.0.1