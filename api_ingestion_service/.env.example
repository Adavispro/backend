# =======================================================
# ADAVIS API Ingestion Module - Environment Variables
# =======================================================
# Copy this file to .env and configure your environment secrets.
# Any variable defined here will override ingestion_config.json.

# MongoDB Connection
MONGO_URI=mongodb://admin:Admin123!@localhost:37017/adavis_platform?authSource=admin
MONGO_DB_NAME=adavis_platform

# Plant API Settings
PLANT_API_BASE_URL=https://u3-miebmr-srv-t
PLANT_API_VERIFY_TLS=false

# Authentication Mode ("oauth2_pkce" | "oauth2_password" | "static_token" | "none")
AUTH_TYPE=oauth2_pkce

# Static Bearer Token (used when AUTH_TYPE=static_token)
PLANT_API_BEARER_TOKEN=PASTE_FRESH_BEARER_TOKEN_HERE

# Dynamic OAuth 2.0 with PKCE Settings (used when AUTH_TYPE=oauth2_pkce or oauth2_password)
OAUTH2_TOKEN_URL=https://u3-miebmr-srv-t/fwxserverweb/security/connect/token
OAUTH2_AUTH_URL=https://u3-miebmr-srv-t/fwxserverweb/security/connect/authorize
OAUTH2_CALLBACK_URL=http://u3-miebmr-srv-t
OAUTH2_CLIENT_ID=In_house_client
OAUTH2_CLIENT_SECRET=
OAUTH2_USERNAME=ebr
OAUTH2_PASSWORD=1234
OAUTH2_SCOPE=openid profile fwxapi offline_access

# Ingestion Mode ("APPEND" | "TRUNCATE_AND_LOAD")
INGESTION_MODE=APPEND

# Backup existing collection before Truncate & Load (true | false)
BACKUP_BEFORE_TRUNCATE=true

# Schedule Frequency (interval in minutes, and continuous loop toggle)
SCHEDULE_MINUTES=15
CONTINUOUS_RUN=true

# Batch Processing Limits (number of batches processed per device per cycle)
MAX_BATCHES_PER_DEVICE=5

# Testing Mode (set to true for local testing with mock server)
USE_MOCK_API=true
MOCK_SERVER_PORT=8001
