# ==============================================================================
# IIoT Multi-Equipment Ingestion - Environment Variable Reference & Template
# ==============================================================================
# Copy this file to .env or export variables directly for deployment.
# All variables support configurable defaults in backend/config/ingestion_config.yaml

# ------------------------------------------------------------------------------
# 1. Execution Control & Schedule
# ------------------------------------------------------------------------------
# Execution mode: ONCE (local batch run) or CONTINUOUS (daemon scheduler loop)
INGESTION_MODE=CONTINUOUS

# Schedule intervals
# Standard production interval is 15 minutes as requested
INGESTION_INTERVAL_MINUTES=15
# Demo/streaming interval (10 seconds)
INGESTION_INTERVAL_SECONDS=10

# Historical backfill start date
DATA_INGESTION_START_DATE="2026-08-15 06:00:00"
INGESTION_FROM_DATE="2026-08-15 06:00:00"
INGESTION_TO_DATE=""

# Max parallel dataset workers
INGESTION_MAX_PARALLEL=5

# ------------------------------------------------------------------------------
# 2. API Source Configuration (RMG, FBD, Blender, Coater)
# ------------------------------------------------------------------------------
# Base URL for REST API (local mock service or server fwxapi gateway)
# Local: http://localhost:8000
# Server: http://<production-gateway-host>:<port>
IIOT_API_BASE_URL=http://localhost:8000
IIOT_API_ENDPOINT=/fwxapi/rest/v1/Dataset
IIOT_API_TIMEOUT_SECONDS=30
IIOT_API_AUTH_TOKEN=""
IIOT_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Compression Machine & File Watcher Configuration (Sejong Tablet Press)
# ------------------------------------------------------------------------------
# Directory polled for Sejong Excel production reports (*.xls, *.xlsx)
# Local: data/ingestion/compression
# Server: /mnt/iiot_share/compression or \\plant-nas\compression\production
COMPRESSION_SOURCE_PATH=data/ingestion/compression

# Column headers in Sejong Excel reports
COMPRESSION_BATCH_COLUMN="Lot No."
COMPRESSION_LOT_COLUMN="Lot No."
COMPRESSION_PRODUCT_CODE_COLUMN="Product Code"
COMPRESSION_PRODUCT_NAME_COLUMN="Product Name"
COMPRESSION_RECIPE_COLUMN="Recipe"
COMPRESSION_EQUIPMENT_COLUMN="Machine Name"
COMPRESSION_TIMESTAMP_COLUMN="Date/Time"
PRODUCTION_REPORT_DATE_COLUMN="Date/Time"

# MDB Decision Gate: MDB_REQUIRED = NO
# Excel reports contain 100% of telemetry, so MDB parsing is disabled by default.
COMPRESSION_MDB_REQUIRED=false
COMPRESSION_MDB_PATH=sample/SawcData.mdb

# ------------------------------------------------------------------------------
# 4. Database & Cache Connectivity
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://admin:Admin123!@localhost:37017/adavis_platform?authSource=admin
MONGODB_DATABASE=adavis_platform

REDIS_HOST=localhost
REDIS_PORT=8379
REDIS_PASSWORD=Redis123!
REDIS_DB=0

# ------------------------------------------------------------------------------
# 5. Fixed Equipment Identifiers (5 Equipments)
# ------------------------------------------------------------------------------
# Equipment 1: Granulation (RMG)
EQUIPMENT_1_ID=MB003
EQUIPMENT_1_CODE=MB003
EQUIPMENT_1_TYPE=RMG
EQUIPMENT_1_ASSET_ID=10094
EQUIPMENT_1_API_ENDPOINT=""

# Equipment 2: Drying (FBD)
EQUIPMENT_2_ID=MB004
EQUIPMENT_2_CODE=MB004
EQUIPMENT_2_TYPE=FBD
EQUIPMENT_2_ASSET_ID=10110
EQUIPMENT_2_API_ENDPOINT=""

# Equipment 3: Blending (BLE)
EQUIPMENT_3_ID=MB005
EQUIPMENT_3_CODE=MB005
EQUIPMENT_3_TYPE=BLE
EQUIPMENT_3_ASSET_ID=10095
EQUIPMENT_3_API_ENDPOINT=""

# Equipment 4: Coating (COAT)
EQUIPMENT_4_ID=MB041
EQUIPMENT_4_CODE=MB041
EQUIPMENT_4_TYPE=COAT
EQUIPMENT_4_ASSET_ID=10141
EQUIPMENT_4_API_ENDPOINT=""

# Equipment 5: Compression (COMP)
COMPRESSION_EQUIPMENT_ID=MB040
COMPRESSION_EQUIPMENT_CODE=MB040
COMPRESSION_EQUIPMENT_TYPE=COMPRESSION
COMPRESSION_ASSET_ID=10040
